{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DebridDock",
  "version": "../package.json",
  "identifier": "dev.rdbatch.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DebridDock",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "shortDescription": "Download manager for debrid services (Real-Debrid, TorBox, AllDebrid)",
    "category": "Utility"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk0QTBCNjI4M0NEQjkwRjYKUldUMmtOczhLTGFnbE5YMHlPcyt6ZnpJS3NRcnE3NkhDcmhOdzZaNkh4Q1dKU2syd1VJMVRiMW8K",
      "endpoints": [
        "https://github.com/coolbirdzik/debrid-torrent-downloader/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
