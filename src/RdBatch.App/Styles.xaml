<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.Light.xaml"/>
    <ResourceDictionary Source="Themes/Light.xaml"/>
  </ResourceDictionary.MergedDictionaries>
  <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  <SolidColorBrush x:Key="AccentButtonBackground" Color="#3159D8"/>
  <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#294FC6"/>
  <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#2445AE"/>
  <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#3159D8"/>
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#294FC6"/>
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#2445AE"/>
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#3159D8"/>
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#294FC6"/>
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="#2445AE"/>
  <SolidColorBrush x:Key="CheckBoxCheckGlyphForeground" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundPressed" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#3159D8"/>
  <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#294FC6"/>
  <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#2445AE"/>
  <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="#FFFFFF"/>
  <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="14,8"/><Setter Property="MinHeight" Value="36"/><Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
    <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="18,10"/><Setter Property="MinHeight" Value="40"/><Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
  </Style>
  <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
    <Setter Property="Foreground" Value="{DynamicResource AccentText}"/><Setter Property="Padding" Value="0"/>
    <Setter Property="MinHeight" Value="24"/><Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>
  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
    <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
  </Style>
  <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
    <Setter Property="FontSize" Value="11"/><Setter Property="Padding" Value="7,4"/>
    <Setter Property="MinHeight" Value="28"/><Setter Property="Margin" Value="0,0,4,0"/>
  </Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
    <Setter Property="Padding" Value="10,9"/><Setter Property="MinHeight" Value="38"/><Setter Property="FontSize" Value="12"/>
  </Style>
  <Style TargetType="PasswordBox" BasedOn="{StaticResource DefaultPasswordBoxStyle}">
    <Setter Property="Padding" Value="10,9"/><Setter Property="MinHeight" Value="38"/>
  </Style>
  <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
    <Setter Property="MinHeight" Value="36"/><Setter Property="FontSize" Value="12"/><Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}"><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Margin" Value="0,0,0,10"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/>
  </Style>
  <Style x:Key="Caption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="19"/>
  </Style>
  <Style x:Key="Symbol" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
    <Setter Property="FontSize" Value="16"/><Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="SectionSurface" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="CornerRadius" Value="16"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/><Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style TargetType="DataGrid" BasedOn="{StaticResource DefaultDataGridStyle}">
    <Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="RowHeight" Value="82"/>
  </Style>
  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="{DynamicResource SubtleSurface}"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    <Setter Property="Padding" Value="14,12"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="BorderThickness" Value="0,1,0,1"/><Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
  </Style>
  <Style TargetType="DataGridCell" BasedOn="{StaticResource DefaultDataGridCellStyle}">
    <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,10"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell">
      <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Background" Value="{DynamicResource SelectedSurface}"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="DataGridRow" BasedOn="{StaticResource DefaultDataGridRowStyle}">
    <Setter Property="Background" Value="{DynamicResource Surface}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource HoverSurface}"/></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectedSurface}"/></Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
