<Window x:Class="RdBatch.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:RdBatch.App"
        Title="Real-Debrid Batch" Icon="Assets/AppIcon.ico" Width="1280" Height="900" MinWidth="1100" MinHeight="760" WindowStartupLocation="CenterScreen"
        Background="#F3F5FA" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" FontSize="13" Closing="OnClosing" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
  <Grid Margin="28,20,28,16">
    <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="204"/><RowDefinition Height="18"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
        <Image Source="Assets/AppIcon.png" Width="42" Height="42" Margin="0,0,13,0" VerticalAlignment="Top"/>
        <StackPanel><TextBlock Text="Real-Debrid Batch" FontSize="24" FontWeight="SemiBold" Margin="0,-3,0,1"/><TextBlock Text="{local:Tr 'Dán torrent. Chọn nơi lưu. Tải toàn bộ.'}" Foreground="{StaticResource Muted}"/></StackPanel>
      </StackPanel>
      <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Margin="0,6,0,0">
        <Border Background="#E6EEFF" Padding="12,7" CornerRadius="5" Margin="0,0,14,0"><TextBlock Text="{local:Tr '✓  TỰ ĐỘNG CHỌN TẤT CẢ FILE'}" FontSize="11" FontWeight="SemiBold" Foreground="#3159D8"/></Border>
        <ComboBox x:Name="LanguageBox" Width="112" Height="30" VerticalContentAlignment="Center" SelectionChanged="LanguageChanged" ToolTip="{local:Tr 'Ngôn ngữ'}" AutomationProperties.Name="{local:Tr 'Ngôn ngữ'}">
          <ComboBoxItem Content="Tiếng Việt" Tag="vi"/><ComboBoxItem Content="English" Tag="en"/>
        </ComboBox>
      </StackPanel>
    </Grid>
    <Border Grid.Row="1" Background="White" CornerRadius="9" BorderBrush="#E2E7F0" BorderThickness="1" Padding="18,14">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid x:Name="AccountPanel"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="38"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel><Button DockPanel.Dock="Right" Content="{local:Tr 'Lấy API token ↗'}" Click="OpenToken" Padding="0" MinHeight="0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Accent}" FontSize="12"/>
            <TextBlock Text="{local:Tr 'TÀI KHOẢN REAL-DEBRID'}" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel>
          <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <PasswordBox x:Name="TokenBox" ToolTip="{local:Tr 'Dán private API token của bạn'}" AutomationProperties.Name="API token" PasswordChanged="TokenChanged"/>
            <Button x:Name="ConnectButton" Grid.Column="2" Content="{local:Tr 'Kiểm tra'}" Click="Connect"/>
          </Grid>
          <DockPanel Grid.Row="3" Margin="0,8,0,0"><CheckBox x:Name="RememberToken" Content="{local:Tr 'Nhớ token trên máy này'}" IsChecked="True" FontSize="12" VerticalAlignment="Center" Click="RememberChanged"/>
            <TextBlock x:Name="AccountStatus" Text="{local:Tr 'Chưa kết nối'}" FontSize="12" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel>
        </Grid>
        <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="38"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="{local:Tr 'NƠI LƯU TOÀN BỘ'}" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource Muted}"/>
          <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="FolderBox" AutomationProperties.Name="{local:Tr 'Thư mục lưu'}" LostFocus="FolderChanged"/>
            <Button x:Name="BrowseButton" Grid.Column="2" Content="{local:Tr 'Chọn…'}" Click="BrowseFolder"/>
          </Grid>
          <CheckBox Grid.Row="3" x:Name="FlattenFilesBox" Content="{local:Tr 'Lưu phẳng · tất cả file vào thư mục đã chọn'}" IsChecked="True" FontSize="12" Margin="0,8,0,0" Click="OutputLayoutChanged"
                    ToolTip="{local:Tr 'Bỏ chọn để tạo thư mục riêng và giữ cấu trúc torrent. Áp dụng cho torrent chưa bắt đầu lưu file; torrent tải dở giữ đường dẫn cũ để tiếp tục.'}"/>
        </Grid>
      </Grid>
    </Border>
    <Border Grid.Row="3" Background="White" CornerRadius="9" BorderBrush="#E2E7F0" BorderThickness="1" Padding="18,14">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="174"/></Grid.ColumnDefinitions>
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel><TextBlock Text="{local:Tr 'THÊM TORRENT HÀNG LOẠT'}" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource Muted}"/>
            <TextBlock Text="{local:Tr 'Mỗi dòng một magnet / URL .torrent / đường dẫn .torrent'}" Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Right"/></DockPanel>
          <Grid Grid.Row="2">
            <TextBox x:Name="SourcesBox" AcceptsReturn="True" VerticalContentAlignment="Top" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Code, Consolas" FontSize="12" TextChanged="SourcesChanged" AutomationProperties.Name="{local:Tr 'Danh sách torrent'}"/>
            <TextBlock x:Name="SourcePlaceholder" IsHitTestVisible="False" Margin="12,10" Foreground="#98A2B5" Text="{local:Tr 'magnet:?xt=urn:btih:…&#10;https://example.com/file.torrent&#10;&#10;Hoặc kéo thả các file .torrent vào cửa sổ'}" FontFamily="Consolas" FontSize="12"/>
          </Grid>
        </Grid>
        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
          <Button x:Name="PasteButton" Content="{local:Tr 'Dán clipboard'}" Click="PasteSources" Margin="0,0,0,8"/>
          <Button x:Name="AddFilesButton" Content="{local:Tr 'Chọn file .torrent…'}" Click="PickTorrents" Margin="0,0,0,8"/>
          <Button x:Name="AddButton" Content="{local:Tr '＋  Thêm vào hàng đợi'}" Style="{StaticResource PrimaryButton}" Click="AddSources"/>
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="5" Background="White" CornerRadius="9" BorderBrush="#E2E7F0" BorderThickness="1">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="18,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center"><TextBlock Text="{local:Tr 'Hàng đợi tải'}" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="QueueSummary" Text="0 torrent" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{local:Tr 'Song song'}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="ConcurrencyBox" Width="52" Height="36" VerticalContentAlignment="Center" SelectedIndex="2" SelectionChanged="ConcurrencyChanged"><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/><ComboBoxItem Content="5"/></ComboBox>
            <Button x:Name="PauseButton" Content="{local:Tr 'Pause tất cả'}" IsEnabled="False" Click="Pause" Margin="12,0,8,0"/>
            <Button x:Name="StopAllButton" Content="{local:Tr 'Stop tất cả'}" IsEnabled="False" Click="StopAll" Margin="0,0,8,0"/>
            <Button x:Name="StartButton" Content="{local:Tr '▶  Bắt đầu / Resume'}" Style="{StaticResource PrimaryButton}" Click="Start"/>
          </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
          <DataGrid x:Name="QueueGrid" ItemsSource="{Binding Jobs}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" Background="White" SelectionMode="Extended" SelectionUnit="FullRow" EnableRowVirtualization="True" RowHeaderWidth="0" HorizontalScrollBarVisibility="Auto" SelectionChanged="QueueSelectionChanged">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="{local:Tr 'TORRENT / FILE'}" Width="*" MinWidth="220"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
              </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="{local:Tr 'DUNG LƯỢNG'}" Binding="{Binding SizeLabel}" Width="108"/>
              <DataGridTemplateColumn Header="{local:Tr 'REAL-DEBRID'}" Width="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding RemoteProgress, StringFormat={}{0:0}%}" FontSize="12"/><ProgressBar Value="{Binding RemoteProgress}" Margin="0,7,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTemplateColumn Header="{local:Tr 'TẢI VỀ MÁY'}" Width="148"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding LocalProgress, StringFormat={}{0:0}%}" FontSize="12"/><ProgressBar Value="{Binding LocalProgress}" Foreground="#1A9A77" Margin="0,7,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTemplateColumn Header="{local:Tr 'TRẠNG THÁI'}" Width="125"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding StateLabel}" FontSize="12" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#53647F"/><Style.Triggers><DataTrigger Binding="{Binding State}" Value="Completed"><Setter Property="Foreground" Value="#168563"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="Failed"><Setter Property="Foreground" Value="#C24348"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="Downloading"><Setter Property="Foreground" Value="#3159D8"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTemplateColumn Header="{local:Tr 'THAO TÁC'}" Width="230" CanUserSort="False"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="{local:Tr 'Retry'}" IsEnabled="{Binding CanRetry}" Click="RetryRow" FontSize="11" Padding="6,6" MinHeight="28" Margin="0,0,4,0" ToolTip="{local:Tr 'Thử lại torrent bị lỗi ngay, tiếp tục phần đã tải nếu có'}"/>
                  <Button Content="{local:Tr 'Resume'}" IsEnabled="{Binding CanResume}" Click="ResumeRow" FontSize="11" Padding="6,6" MinHeight="28" Margin="0,0,4,0" ToolTip="{local:Tr 'Bắt đầu hoặc tiếp tục torrent này'}"/>
                  <Button Content="{local:Tr 'Stop'}" IsEnabled="{Binding CanStop}" Click="StopRow" FontSize="11" Padding="6,6" MinHeight="28" Margin="0,0,4,0" ToolTip="{local:Tr 'Dừng tác vụ này trong app; giữ file tạm để Resume. Torrent trên Real-Debrid tiếp tục xử lý.'}"/>
                  <Button Content="{local:Tr 'Xóa'}" IsEnabled="{Binding CanRemove}" Click="RemoveRow" FontSize="11" Padding="6,6" MinHeight="28" Foreground="#C24348" ToolTip="{local:Tr 'Dừng tác vụ và xóa dòng khỏi danh sách. Giữ file trên máy và torrent trên Real-Debrid.'}"/>
                </StackPanel>
              </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel x:Name="EmptyState" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,35,0,0"><TextBlock Text="{local:Tr 'Sẵn sàng cho loạt tải đầu tiên'}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="{local:Tr 'Thêm torrent ở trên, rồi bấm Bắt đầu tải.&#10;Toàn bộ file sẽ được chọn tự động.'}" Foreground="{StaticResource Muted}" TextAlignment="Center" Margin="0,9,0,0" LineHeight="21"/></StackPanel>
        </Grid>
        <DockPanel Grid.Row="2" Margin="14,10" LastChildFill="False">
          <TextBlock Text="{local:Tr 'Dòng đã chọn:'}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <Button x:Name="RetryButton" Content="{local:Tr 'Retry'}" Click="RetrySelected" Padding="11,6" MinHeight="30" IsEnabled="False"/>
          <Button x:Name="ResumeSelectedButton" Content="{local:Tr 'Resume'}" Click="ResumeSelected" Padding="11,6" MinHeight="30" Margin="8,0,0,0" IsEnabled="False"/>
          <Button x:Name="StopSelectedButton" Content="{local:Tr 'Stop'}" Click="StopSelected" Padding="11,6" MinHeight="30" Margin="8,0,0,0" IsEnabled="False"/>
          <Button x:Name="RemoveButton" Content="{local:Tr 'Xóa khỏi danh sách'}" Click="RemoveSelected" Padding="11,6" MinHeight="30" Margin="8,0,0,0" IsEnabled="False" ToolTip="{local:Tr 'Dừng rồi bỏ dòng khỏi app, giữ file đã tải và torrent trên Real-Debrid'}"/>
          <Button x:Name="ClearQueueButton" Content="{local:Tr 'Xóa toàn bộ'}" Click="ClearQueue" Padding="11,6" MinHeight="30" Margin="16,0,0,0" IsEnabled="False" Foreground="#C24348" ToolTip="{local:Tr 'Dừng mọi tác vụ rồi xóa toàn bộ hàng đợi. Giữ file đã tải, file tạm và torrent trên Real-Debrid.'}"/>
          <Button DockPanel.Dock="Right" Content="{local:Tr 'Mở thư mục lưu ↗'}" Click="OpenOutput" Padding="11,6" MinHeight="30"/>
        </DockPanel>
      </Grid>
    </Border>
    <TextBlock Grid.Row="6" x:Name="StatusText" Text="{local:Tr 'Sẵn sàng · Token được mã hóa bằng tài khoản Windows khi lưu.'}" FontSize="12" Foreground="{StaticResource Muted}" Margin="2,12,0,0" TextWrapping="Wrap"/>
  </Grid>
</Window>
