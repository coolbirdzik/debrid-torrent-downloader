<Window x:Class="RdBatch.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:RdBatch.App"
        Title="Real-Debrid Batch" Icon="Assets/AppIcon.ico" Width="1440" Height="940" MinWidth="1180" MinHeight="760"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        Closing="OnClosing" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
  <Window.CommandBindings><CommandBinding Command="{x:Static local:MainWindow.RemoveFolderCommand}" Executed="RemoveFolderExecuted" CanExecute="CanRemoveFolder"/></Window.CommandBindings>
  <Grid Margin="20,14,20,0">
    <Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
        <Image Source="Assets/AppIcon.png" Width="36" Height="36" Margin="0,2,12,0" VerticalAlignment="Top"/>
        <StackPanel>
          <TextBlock Text="Real-Debrid Batch" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="21" FontWeight="SemiBold"/>
          <TextBlock Text="{local:Tr 'Không gian tải của bạn.'}" Style="{StaticResource Caption}" Margin="0,1,0,0"/>
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,2,0,0">
        <ComboBox x:Name="ThemeBox" Width="136" SelectionChanged="AppearanceChanged" Margin="0,0,10,0" ToolTip="{local:Tr 'Giao diện'}" AutomationProperties.Name="{local:Tr 'Giao diện'}">
          <ComboBoxItem Content="{local:Tr 'Theo hệ thống'}" Tag="system"/><ComboBoxItem Content="{local:Tr 'Sáng'}" Tag="light"/><ComboBoxItem Content="{local:Tr 'Tối'}" Tag="dark"/>
        </ComboBox>
        <ComboBox x:Name="LanguageBox" Width="124" SelectionChanged="LanguageChanged" ToolTip="{local:Tr 'Ngôn ngữ'}" AutomationProperties.Name="{local:Tr 'Ngôn ngữ'}">
          <ComboBoxItem Content="Tiếng Việt" Tag="vi"/><ComboBoxItem Content="English" Tag="en"/>
        </ComboBox>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="248"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="Transparent" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,1,0" Padding="0,10,20,12">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Text="{local:Tr 'Thiết lập tải'}" Style="{StaticResource SectionTitle}" Margin="0,0,0,22"/>
            <StackPanel x:Name="AccountPanel">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="&#xE77B;" Style="{StaticResource Symbol}" FontSize="14" Foreground="{DynamicResource AccentText}" Margin="0,0,8,0"/>
                <TextBlock Text="{local:Tr 'Tài khoản'}" Style="{StaticResource FieldLabel}" Margin="0"/>
              </StackPanel>
              <PasswordBox x:Name="TokenBox" ToolTip="{local:Tr 'Dán private API token của bạn'}" AutomationProperties.Name="API token" PasswordChanged="TokenChanged"/>
              <Grid Margin="0,10,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button Content="{local:Tr 'Lấy API token'}" Click="OpenToken" Style="{StaticResource LinkButton}"/>
                <Button x:Name="ConnectButton" Grid.Column="1" Content="{local:Tr 'Kiểm tra'}" Click="Connect" Padding="14,7"/>
              </Grid>
              <CheckBox x:Name="RememberToken" Content="{local:Tr 'Nhớ token trên máy này'}" IsChecked="True" Click="RememberChanged"/>
              <TextBlock x:Name="AccountStatus" Text="{local:Tr 'Chưa kết nối'}" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
            </StackPanel>
            <Border Background="{DynamicResource Stroke}" Height="1" Margin="0,22"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <TextBlock Text="&#xE8B7;" Style="{StaticResource Symbol}" FontSize="14" Foreground="{DynamicResource AccentText}" Margin="0,0,8,0"/>
              <TextBlock Text="{local:Tr 'Thư mục tải xuống'}" Style="{StaticResource FieldLabel}" Margin="0"/>
            </StackPanel>
            <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="FolderBox" AutomationProperties.Name="{local:Tr 'Thư mục lưu'}" LostFocus="FolderChanged"/>
              <Button x:Name="BrowseButton" Grid.Column="1" Content="&#xE838;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" FontWeight="Normal" Padding="0" Width="38" MinHeight="38" Margin="6,0,0,0" Click="BrowseFolder" ToolTip="{local:Tr 'Chọn thư mục'}" AutomationProperties.Name="{local:Tr 'Chọn thư mục'}"/>
            </Grid>
            <CheckBox x:Name="FlattenFilesBox" Content="{local:Tr 'Lưu tất cả file cùng thư mục'}" IsChecked="True" Click="OutputLayoutChanged"
                ToolTip="{local:Tr 'Bỏ chọn để tạo thư mục riêng và giữ cấu trúc torrent. Áp dụng cho torrent chưa bắt đầu lưu file; torrent tải dở giữ đường dẫn cũ để tiếp tục.'}"/>
            <TextBlock Text="{local:Tr 'File tải dở giữ nguyên đường dẫn để tiếp tục.'}" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
            <Border Background="{DynamicResource SubtleSurface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,24,0,0">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="&#xE82F;" Style="{StaticResource Symbol}" FontSize="15" Foreground="{DynamicResource AccentText}" VerticalAlignment="Top" Margin="0,1,0,0"/>
                <StackPanel Grid.Column="1"><TextBlock Text="{local:Tr 'Chọn đúng file bạn cần'}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock Text="{local:Tr 'Duyệt thư mục, tìm video rồi thêm các file đã chọn vào hàng đợi.'}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="6"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border x:Name="SourcesPanel" Padding="0,10,0,0">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="52"/><RowDefinition Height="6"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="{local:Tr 'Thêm torrent'}" Style="{StaticResource FieldLabel}" Margin="0"/>
            <Grid Grid.Row="2">
              <TextBox x:Name="SourcesBox" AcceptsReturn="True" VerticalContentAlignment="Top" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Code, Consolas" FontSize="12" TextChanged="SourcesChanged" AutomationProperties.Name="{local:Tr 'Danh sách torrent'}" ToolTip="{local:Tr 'Dán nhiều link, mỗi dòng một torrent; bấm Thêm vào thư viện để đọc file.'}"/>
              <TextBlock x:Name="SourcePlaceholder" IsHitTestVisible="False" Margin="12,9" Foreground="{DynamicResource Muted}" Text="{local:Tr 'magnet:?xt=urn:btih:…&#10;Hoặc kéo thả các file .torrent vào cửa sổ'}" FontFamily="Consolas" FontSize="12"/>
            </Grid>
            <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="PasteButton" Content="{local:Tr 'Dán clipboard'}" Click="PasteSources" Style="{StaticResource QuietButton}" Padding="8,4" MinHeight="28" Margin="-8,0,4,0"/>
                <Button x:Name="AddFilesButton" Content="{local:Tr 'Chọn file .torrent…'}" Click="PickTorrents" Style="{StaticResource QuietButton}" Padding="8,4" MinHeight="28"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CancelInspectButton" Content="{local:Tr 'Dừng đọc'}" Click="CancelInspection" Style="{StaticResource QuietButton}" Visibility="Collapsed" Margin="0,0,8,0"/>
                <Button x:Name="AddButton" Content="{local:Tr 'Thêm vào thư viện'}" Style="{StaticResource PrimaryButton}" Click="AddSources" MinHeight="32" Padding="14,6"/>
              </StackPanel>
            </Grid>
          </Grid>
        </Border>

        <TabControl x:Name="WorkspaceTabs" Grid.Row="2" Background="Transparent" BorderThickness="0" Padding="0" SelectionChanged="WorkspaceTabChanged">
          <TabItem Header="{local:Tr 'File trong torrent'}">
            <Border Style="{StaticResource SectionSurface}">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Margin="16,14,16,12">
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock x:Name="BrowserPath" Style="{StaticResource SectionTitle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,0,12,12"/>
                  <TextBlock x:Name="BrowserSummary" Grid.Column="1" Style="{StaticResource Caption}" VerticalAlignment="Top" Margin="0,2,0,12"/>
                  <TextBox x:Name="SearchFilesBox" Grid.Row="1" TextChanged="BrowserFilterChanged" AutomationProperties.Name="{local:Tr 'Tìm file trong thư mục và thư mục con'}" ToolTip="{local:Tr 'Tìm file trong thư mục và thư mục con'}" Padding="34,9,10,9"/>
                  <TextBlock Grid.Row="1" Text="&#xE721;" Style="{StaticResource Symbol}" IsHitTestVisible="False" Foreground="{DynamicResource Muted}" HorizontalAlignment="Left" Margin="11,0,0,0"/>
                  <TextBlock Grid.Row="1" Margin="35,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" IsHitTestVisible="False" Text="{local:Tr 'Tìm tên video, file hoặc thư mục…'}">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchFilesBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                  </TextBlock>
                  <CheckBox x:Name="VideoOnlyBox" Grid.Row="1" Grid.Column="1" Content="{local:Tr 'Chỉ video'}" VerticalAlignment="Center" Margin="18,0,0,0" Checked="BrowserFilterChanged" Unchecked="BrowserFilterChanged"/>
                  <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="-10,0,0,0">
                      <Button x:Name="RemoveBrowserFilesButton" Content="{local:Tr 'Bỏ khỏi thư viện'}" Click="RemoveBrowserFiles" Style="{StaticResource DangerButton}" IsEnabled="False" ToolTip="{local:Tr 'Chỉ bỏ file đã chọn khỏi thư viện ảo; giữ file trên máy, torrent trên Real-Debrid và hàng đợi đã tạo.'}"/>
                      <Button x:Name="UndoBrowserRemovalButton" Content="{local:Tr 'Hoàn tác'}" Click="UndoBrowserRemoval" Style="{StaticResource QuietButton}" IsEnabled="False"/>
                      <Button x:Name="NewBatchButton" Content="{local:Tr 'Batch mới'}" Click="ClearVirtualLibrary" Style="{StaticResource QuietButton}" ToolTip="{local:Tr 'Xóa toàn bộ thư viện ảo, ô nhập và bộ lọc để thêm batch mới. Giữ hàng đợi, file trên máy và torrent trên Real-Debrid.'}"/>
                    </StackPanel>
                    <ComboBox x:Name="BrowserViewBox" Grid.Column="1" Width="142" SelectionChanged="BrowserViewChanged" AutomationProperties.Name="{local:Tr 'Kiểu xem file'}">
                      <ComboBoxItem Content="{local:Tr 'Danh sách'}"/><ComboBoxItem Content="{local:Tr 'Lưới'}"/>
                    </ComboBox>
                  </Grid>
                  <ProgressBar x:Name="InspectProgress" Grid.Row="3" Grid.ColumnSpan="2" Height="3" Margin="0,12,0,0" IsIndeterminate="True" Visibility="Collapsed"/>
                </Grid>
                <Grid Grid.Row="1">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Background="{DynamicResource SubtleSurface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,1,0" Padding="6,6,6,8">
                    <DockPanel>
                      <Grid DockPanel.Dock="Top" Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button x:Name="ShowAllFilesButton" Content="{local:Tr 'Bỏ lọc, xem tất cả'}" Click="ShowAllFiles" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Padding="8,4" MinHeight="32"/>
                        <Button x:Name="RemoveBrowserFolderButton" Grid.Column="1" Content="&#xE74D;" Click="RemoveSelectedBrowserFolder" Style="{StaticResource IconButton}" Foreground="{DynamicResource Danger}" IsEnabled="False" AutomationProperties.Name="{local:Tr 'Bỏ thư mục'}" ToolTip="{local:Tr 'Bỏ thư mục đang chọn cùng toàn bộ file và thư mục con, kể cả file ngoài bộ lọc hiện tại. Có thể Hoàn tác; giữ queue, file trên máy và torrent trên Real-Debrid.'}"/>
                      </Grid>
                      <Border DockPanel.Dock="Top" Background="{DynamicResource Stroke}" Height="1" Margin="2,0,2,6"/>
                      <TreeView x:Name="FolderTree" ItemsSource="{Binding BrowserFolders}" SelectedItemChanged="BrowserFolderChanged" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Ink}" AutomationProperties.Name="{local:Tr 'Thư mục torrent'}" ScrollViewer.HorizontalScrollBarVisibility="Auto" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" PreviewKeyDown="BrowserFoldersKeyDown">
                        <TreeView.Resources>
                          <HierarchicalDataTemplate DataType="{x:Type local:TorrentFolder}" ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="0,5"><TextBlock Text="&#xE8B7;" Style="{StaticResource Symbol}" Foreground="{DynamicResource AccentText}" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" VerticalAlignment="Center"/></StackPanel>
                          </HierarchicalDataTemplate>
                        </TreeView.Resources>
                        <TreeView.ItemContainerStyle>
                          <Style TargetType="TreeViewItem">
                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="FolderRightClick"/>
                            <Setter Property="ContextMenu"><Setter.Value><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><MenuItem Header="{local:Tr 'Bỏ thư mục khỏi thư viện'}" IsEnabled="{Binding CanRemove}" Command="{x:Static local:MainWindow.RemoveFolderCommand}" CommandParameter="{Binding}" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/></ContextMenu></Setter.Value></Setter>
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/><Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TreeViewItem">
                              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <ToggleButton x:Name="Expander" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" Width="18" Height="28" Foreground="{DynamicResource Muted}" AutomationProperties.Name="{Binding Name}">
                                  <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><TextBlock x:Name="Arrow" Text="›" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
                                </ToggleButton>
                                <Border x:Name="FolderHeader" Grid.Column="1" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="4,0"><ContentPresenter ContentSource="Header"/></Border>
                                <ItemsPresenter x:Name="FolderChildren" Grid.Row="1" Grid.Column="1"/>
                              </Grid>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="False"><Setter TargetName="FolderChildren" Property="Visibility" Value="Collapsed"/></Trigger>
                                <Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden"/></Trigger>
                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="FolderHeader" Property="Background" Value="{DynamicResource SelectedSurface}"/></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FolderHeader" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate></Setter.Value></Setter>
                          </Style>
                        </TreeView.ItemContainerStyle>
                      </TreeView>
                    </DockPanel>
                  </Border>
                  <Grid Grid.Column="1">
                    <DataGrid x:Name="BrowserGrid" ItemsSource="{Binding BrowserFiles}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" HeadersVisibility="Column" RowHeaderWidth="0" RowHeight="60" SelectionMode="Extended" SelectionUnit="FullRow" EnableRowVirtualization="True" AutomationProperties.Name="{local:Tr 'Danh sách file trong torrent'}" PreviewKeyDown="BrowserFilesKeyDown" PreviewMouseDown="BrowserPointerDown">
                      <DataGrid.RowStyle><Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}"><Setter Property="IsSelected" Value="{Binding IsSelected, Mode=OneWay}"/></Style></DataGrid.RowStyle>
                      <DataGrid.Columns>
                        <DataGridTemplateColumn Width="52" CanUserSort="False" CellStyle="{StaticResource CheckCell}"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                          <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Location}" HorizontalAlignment="Center"/>
                        </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{local:Tr 'Tên file'}" Width="*" MinWidth="150"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource AccentSoft}" Width="32" Height="32" CornerRadius="8" HorizontalAlignment="Left"><TextBlock Text="{Binding Icon}" Style="{StaticResource Symbol}" FontSize="15" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center"/></Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" ToolTip="{Binding Name}"/><TextBlock Text="{Binding Location}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Location}"/></StackPanel>
                          </Grid>
                        </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTextColumn Header="{local:Tr 'Dung lượng'}" Binding="{Binding SizeLabel}" Width="104"/>
                        <DataGridTemplateColumn Header="{local:Tr 'Loại / Trạng thái'}" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding StatusLabel}" ToolTip="{Binding StatusLabel}" TextTrimming="CharacterEllipsis"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                      </DataGrid.Columns>
                    </DataGrid>
                    <ScrollViewer x:Name="BrowserTilesScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource Surface}" Padding="12,10" PreviewKeyDown="BrowserFilesKeyDown">
                      <ItemsControl x:Name="BrowserTiles" ItemsSource="{Binding BrowserFiles}" AutomationProperties.Name="{local:Tr 'Lưới file trong torrent'}" PreviewMouseDown="BrowserPointerDown">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                          <ToggleButton IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="164" Height="136" Margin="4" Padding="12" Cursor="Hand" ToolTip="{Binding Location}" AutomationProperties.Name="{Binding Location}">
                            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                              <Border x:Name="Tile" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource HoverSurface}"/></Trigger>
                                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource SelectedSurface}"/><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate></ToggleButton.Template>
                            <Grid>
                              <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                              <Border Background="{DynamicResource AccentSoft}" Width="44" Height="44" CornerRadius="10" HorizontalAlignment="Left"><TextBlock Text="{Binding Icon}" Style="{StaticResource Symbol}" FontSize="22" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center"/></Border>
                              <Border Background="{DynamicResource Accent}" Width="20" Height="20" CornerRadius="10" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="{Binding IsSelected, Converter={StaticResource BoolVisibility}}"><TextBlock Text="&#xE73E;" Style="{StaticResource Symbol}" FontSize="11" Foreground="White" HorizontalAlignment="Center"/></Border>
                              <TextBlock Grid.Row="1" Text="{Binding Name}" Foreground="{DynamicResource Ink}" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="38" Margin="0,10,0,4"/>
                              <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding SizeLabel}" Foreground="{DynamicResource Muted}" FontSize="11"/>
                                <TextBlock Grid.Column="1" Text="{Binding StatusLabel}" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" TextAlignment="Right" Margin="8,0,0,0"/>
                              </Grid>
                            </Grid>
                          </ToggleButton>
                        </DataTemplate></ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                    <Border Background="{DynamicResource AccentSoft}" Width="48" Height="48" CornerRadius="14" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,64" IsHitTestVisible="False" Visibility="{Binding Visibility, ElementName=BrowserEmpty}"><TextBlock Text="&#xE8B7;" Style="{StaticResource Symbol}" FontSize="20" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center"/></Border>
                    <TextBlock x:Name="BrowserEmpty" Style="{StaticResource Caption}" TextAlignment="Center" MaxWidth="320" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,45,24,0" IsHitTestVisible="False"/>
                  </Grid>
                </Grid>
                <Border Grid.Row="2" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Padding="16,12">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                      <TextBlock x:Name="SelectionSummary" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{local:Tr 'Đổi bộ lọc sẽ bỏ chọn các kết quả trước.'}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button x:Name="SelectResultsButton" Content="{local:Tr 'Chọn / bỏ chọn kết quả'}" Click="SelectResults" Style="{StaticResource QuietButton}" Margin="8,0" MinWidth="170"/>
                      <Button x:Name="QueueRemainingButton" Content="{local:Tr 'Thêm tất cả còn lại'}" Click="QueueRemainingFiles" Margin="0,0,8,0" IsEnabled="False" ToolTip="{local:Tr 'Thêm mọi file còn lại trong toàn bộ thư viện vào queue, kể cả ngoài bộ lọc hiện tại; bỏ qua file đã có trong queue.'}"/>
                      <Button x:Name="QueueFilesButton" Content="{local:Tr 'Thêm vào hàng đợi'}" Click="QueueSelectedFiles" Style="{StaticResource PrimaryButton}" MinWidth="160" IsEnabled="False"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </Grid>
            </Border>
          </TabItem>
          <TabItem Header="{local:Tr 'Hàng đợi tải'}">
        <Border Style="{StaticResource SectionSurface}">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="16,14,16,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="QueueSummary" Style="{StaticResource SectionTitle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,16,0"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="{local:Tr 'Song song'}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="ConcurrencyBox" Width="68" SelectedIndex="2" SelectionChanged="ConcurrencyChanged" VerticalAlignment="Center" AutomationProperties.Name="{local:Tr 'Số torrent tải song song'}"><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/><ComboBoxItem Content="5"/></ComboBox>
                <Border Background="{DynamicResource Stroke}" Width="1" Height="24" Margin="14,0,10,0" VerticalAlignment="Center"/>
                <Button x:Name="PauseButton" Content="{local:Tr 'Pause tất cả'}" IsEnabled="False" Click="Pause" Style="{StaticResource QuietButton}" Margin="0,0,4,0"/>
                <Button x:Name="StopAllButton" Content="{local:Tr 'Stop tất cả'}" IsEnabled="False" Click="StopAll" Style="{StaticResource QuietButton}" Margin="0,0,8,0"/>
                <Button x:Name="StartButton" Content="{local:Tr 'Bắt đầu / Resume'}" Style="{StaticResource PrimaryButton}" Click="Start"/>
              </StackPanel>
            </Grid>
            <Grid Grid.Row="1">
              <DataGrid x:Name="QueueGrid" ItemsSource="{Binding Jobs}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" HeadersVisibility="Column" SelectionMode="Extended" SelectionUnit="FullRow" EnableRowVirtualization="True" RowHeaderWidth="0" HorizontalScrollBarVisibility="Auto" SelectionChanged="QueueSelectionChanged">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="{local:Tr 'Torrent / File'}" Width="*" MinWidth="200"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
                  </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTextColumn Header="{local:Tr 'Dung lượng'}" Binding="{Binding SizeLabel}" Width="90"/>
                  <DataGridTemplateColumn Header="Real-Debrid" Width="108"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding RemoteProgress, StringFormat={}{0:0}%}" FontSize="12"/>
                    <Border Background="{DynamicResource ProgressTrack}" Height="4" CornerRadius="2" Margin="0,9,0,0"><ProgressBar Value="{Binding RemoteProgress}" Height="4" Foreground="{DynamicResource ProgressFill}" Background="Transparent" BorderThickness="0"/></Border>
                  </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="{local:Tr 'Tải về máy'}" Width="108"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding LocalProgress, StringFormat={}{0:0}%}" FontSize="12"/>
                    <Border Background="{DynamicResource ProgressTrack}" Height="4" CornerRadius="2" Margin="0,9,0,0"><ProgressBar Value="{Binding LocalProgress}" Height="4" Foreground="{DynamicResource ProgressFill}" Background="Transparent" BorderThickness="0"/></Border>
                  </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="{local:Tr 'Trạng thái'}" Width="112"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                    <Border CornerRadius="10" Padding="10,4" HorizontalAlignment="Left"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource SubtleSurface}"/>
                      <Style.Triggers><DataTrigger Binding="{Binding State}" Value="Completed"><Setter Property="Background" Value="{DynamicResource SuccessSoft}"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="Failed"><Setter Property="Background" Value="{DynamicResource DangerSoft}"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="Downloading"><Setter Property="Background" Value="{DynamicResource AccentSoft}"/></DataTrigger></Style.Triggers>
                    </Style></Border.Style>
                      <TextBlock Text="{Binding StateLabel}" FontSize="11" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                        <Style.Triggers><DataTrigger Binding="{Binding State}" Value="Completed"><Setter Property="Foreground" Value="{DynamicResource Success}"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="Failed"><Setter Property="Foreground" Value="{DynamicResource Danger}"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="Downloading"><Setter Property="Foreground" Value="{DynamicResource AccentText}"/></DataTrigger></Style.Triggers>
                      </Style></TextBlock.Style></TextBlock>
                    </Border>
                  </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="{local:Tr 'Thao tác'}" Width="172" CanUserSort="False"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal">
                    <Button Content="{local:Tr 'Retry'}" Visibility="{Binding CanRetry, Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding CanRetry}" Click="RetryRow" Style="{StaticResource RowButton}" ToolTip="{local:Tr 'Thử lại torrent bị lỗi ngay, tiếp tục phần đã tải nếu có'}"/>
                    <Button Content="{local:Tr 'Resume'}" Visibility="{Binding CanResume, Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding CanResume}" Click="ResumeRow" Style="{StaticResource RowButton}" ToolTip="{local:Tr 'Bắt đầu hoặc tiếp tục torrent này'}"/>
                    <Button Content="{local:Tr 'Stop'}" Visibility="{Binding CanStop, Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding CanStop}" Click="StopRow" Style="{StaticResource RowButton}" ToolTip="{local:Tr 'Dừng tác vụ này trong app; giữ file tạm để Resume. Torrent trên Real-Debrid tiếp tục xử lý.'}"/>
                    <Button Content="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" AutomationProperties.Name="{local:Tr 'Xóa'}" IsEnabled="{Binding CanRemove}" Click="RemoveRow" Style="{StaticResource RowButton}" Foreground="{DynamicResource Danger}" Padding="6,4" MinWidth="28" Margin="0" ToolTip="{local:Tr 'Dừng tác vụ và xóa dòng khỏi danh sách. Giữ file trên máy và torrent trên Real-Debrid.'}"/>
                  </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
              <StackPanel x:Name="EmptyState" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,30,0,0">
                <Border Background="{DynamicResource AccentSoft}" Width="56" Height="56" CornerRadius="16" HorizontalAlignment="Center" Margin="0,0,0,18"><TextBlock Text="&#xE896;" Style="{StaticResource Symbol}" Foreground="{DynamicResource AccentText}" FontSize="24" HorizontalAlignment="Center"/></Border>
                <TextBlock Text="{local:Tr 'Sẵn sàng cho loạt tải đầu tiên'}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="{local:Tr 'Chọn file ở tab File trong torrent rồi thêm vào hàng đợi.'}" Style="{StaticResource Caption}" TextAlignment="Center" MaxWidth="340" Margin="0,8,0,0"/>
              </StackPanel>
            </Grid>
            <Border Grid.Row="2" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Padding="16,10">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <WrapPanel VerticalAlignment="Center">
                  <TextBlock Text="{local:Tr 'Dòng đã chọn:'}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" FontSize="11" Margin="0,0,10,0"/>
                  <Button x:Name="RetryButton" Content="{local:Tr 'Retry'}" Click="RetrySelected" Style="{StaticResource QuietButton}" Padding="10,6" MinHeight="32" IsEnabled="False"/>
                  <Button x:Name="ResumeSelectedButton" Content="{local:Tr 'Resume'}" Click="ResumeSelected" Style="{StaticResource QuietButton}" Padding="10,6" MinHeight="32" IsEnabled="False"/>
                  <Button x:Name="StopSelectedButton" Content="{local:Tr 'Stop'}" Click="StopSelected" Style="{StaticResource QuietButton}" Padding="10,6" MinHeight="32" IsEnabled="False"/>
                  <Button x:Name="RemoveButton" Content="{local:Tr 'Xóa khỏi danh sách'}" Click="RemoveSelected" Style="{StaticResource QuietButton}" Padding="10,6" MinHeight="32" IsEnabled="False" ToolTip="{local:Tr 'Dừng rồi bỏ dòng khỏi app, giữ file đã tải và torrent trên Real-Debrid'}"/>
                </WrapPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                  <Button Content="{local:Tr 'Mở thư mục'}" Click="OpenOutput" Style="{StaticResource QuietButton}" Padding="10,6" MinHeight="32"/>
                  <Button x:Name="ClearQueueButton" Content="{local:Tr 'Xóa toàn bộ'}" Click="ClearQueue" Style="{StaticResource DangerButton}" Padding="10,6" MinHeight="32" IsEnabled="False" ToolTip="{local:Tr 'Dừng mọi tác vụ rồi xóa toàn bộ hàng đợi. Giữ file đã tải, file tạm và torrent trên Real-Debrid.'}"/>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Border>
          </TabItem>
          <TabItem Header="{local:Tr 'Torrent trên Real-Debrid'}">
            <Border Style="{StaticResource SectionSurface}">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Margin="16,14,16,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,16,0">
                    <TextBlock x:Name="RemoteSummary" Style="{StaticResource SectionTitle}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{local:Tr 'Toàn bộ torrent trong tài khoản Real-Debrid của token hiện tại. Xóa ở đây là xóa trên Real-Debrid.'}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                  </StackPanel>
                  <Button x:Name="RemoteRefreshButton" Grid.Column="1" Click="RefreshRemoteTorrents" Style="{StaticResource QuietButton}" VerticalAlignment="Center" ToolTip="{local:Tr 'Tải lại danh sách từ Real-Debrid'}" AutomationProperties.Name="{local:Tr 'Tải lại danh sách từ Real-Debrid'}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource Symbol}" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="{local:Tr 'Tải lại'}" VerticalAlignment="Center"/></StackPanel>
                  </Button>
                </Grid>
                <ProgressBar x:Name="RemoteLoadProgress" Height="3" IsIndeterminate="True" VerticalAlignment="Bottom" Margin="16,0" Visibility="Collapsed"/>
                <Border Grid.Row="1" Background="{DynamicResource DangerSoft}" CornerRadius="8" Padding="16,12" Margin="16,0,16,12">
                  <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Visibility, ElementName=RemoteReviewNotice}" Value="Collapsed"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                  <TextBlock x:Name="RemoteReviewNotice" TextWrapping="Wrap" Foreground="{DynamicResource Ink}" Visibility="Collapsed"/>
                </Border>
                <DataGrid x:Name="RemoteGrid" Grid.Row="2" ItemsSource="{Binding RemoteTorrents}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" HeadersVisibility="Column" RowHeaderWidth="0" RowHeight="60" SelectionMode="Extended" SelectionUnit="FullRow" EnableRowVirtualization="True" AutomationProperties.Name="{local:Tr 'Danh sách torrent trên tài khoản Real-Debrid'}" PreviewMouseDown="RemotePointerDown">
                  <DataGrid.RowStyle><Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}"><Setter Property="IsSelected" Value="{Binding IsSelected, Mode=OneWay}"/></Style></DataGrid.RowStyle>
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Width="52" CanUserSort="False" CellStyle="{StaticResource CheckCell}"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanDelete}" AutomationProperties.Name="{Binding Name}" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{local:Tr 'Torrent / ID'}" Width="*" MinWidth="180" SortMemberPath="Name"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                      <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding Id}" FontSize="11" FontFamily="Cascadia Code, Consolas" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" ToolTip="{Binding Id}"/>
                        <Border Background="{DynamicResource AccentSoft}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsQueued, Converter={StaticResource BoolVisibility}}"><TextBlock Text="{local:Tr 'Trong hàng đợi'}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}"/></Border>
                      </StackPanel>
                    </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTextColumn Header="{local:Tr 'Dung lượng'}" Binding="{Binding SizeLabel}" SortMemberPath="Torrent.Bytes" Width="100"/>
                    <DataGridTemplateColumn Header="{local:Tr 'Trạng thái'}" Width="190" SortMemberPath="Torrent.Status"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                      <Border CornerRadius="10" Padding="10,4" HorizontalAlignment="Left" ToolTip="{Binding Status}"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource SubtleSurface}"/>
                        <Style.Triggers><DataTrigger Binding="{Binding Tone}" Value="success"><Setter Property="Background" Value="{DynamicResource SuccessSoft}"/></DataTrigger><DataTrigger Binding="{Binding Tone}" Value="error"><Setter Property="Background" Value="{DynamicResource DangerSoft}"/></DataTrigger><DataTrigger Binding="{Binding Tone}" Value="active"><Setter Property="Background" Value="{DynamicResource AccentSoft}"/></DataTrigger></Style.Triggers>
                      </Style></Border.Style>
                        <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                          <Style.Triggers><DataTrigger Binding="{Binding Tone}" Value="success"><Setter Property="Foreground" Value="{DynamicResource Success}"/></DataTrigger><DataTrigger Binding="{Binding Tone}" Value="error"><Setter Property="Foreground" Value="{DynamicResource Danger}"/></DataTrigger><DataTrigger Binding="{Binding Tone}" Value="active"><Setter Property="Foreground" Value="{DynamicResource AccentText}"/></DataTrigger></Style.Triggers>
                        </Style></TextBlock.Style></TextBlock>
                      </Border>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTextColumn Header="{local:Tr 'Ngày thêm'}" Binding="{Binding AddedLabel}" SortMemberPath="Torrent.Added" Width="136"/>
                  </DataGrid.Columns>
                </DataGrid>
                <StackPanel x:Name="RemoteEmpty" Grid.Row="2" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,40,24,0" Visibility="Collapsed">
                  <Border Background="{DynamicResource AccentSoft}" Width="48" Height="48" CornerRadius="14" HorizontalAlignment="Center" Margin="0,0,0,14"><TextBlock Text="&#xE753;" Style="{StaticResource Symbol}" FontSize="20" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center"/></Border>
                  <TextBlock x:Name="RemoteEmptyText" Style="{StaticResource Caption}" TextAlignment="Center" MaxWidth="360"/>
                </StackPanel>
                <Border Grid.Row="3" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Padding="16,10">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button x:Name="RemoteSelectAllButton" Content="{local:Tr 'Chọn / bỏ chọn tất cả'}" Click="SelectRemoteTorrents" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="RemoteCancelButton" Content="{local:Tr 'Hủy'}" Click="CancelRemoteDeletion" Style="{StaticResource QuietButton}" Margin="0,0,8,0" Visibility="Collapsed"/>
                    <Button x:Name="RemoteReviewButton" Content="{local:Tr 'Xóa torrent đã chọn…'}" Click="ReviewRemoteDeletion" Style="{StaticResource DangerButton}" IsEnabled="False"/>
                    <Button x:Name="RemoteConfirmButton" Content="{local:Tr 'Xác nhận xóa trên Real-Debrid'}" Click="ConfirmRemoteDeletion" Style="{StaticResource DangerButton}" MinWidth="240" Visibility="Collapsed"/>
                  </StackPanel>
                  </Grid>
                </Border>
              </Grid>
            </Border>
          </TabItem>
        </TabControl>
      </Grid>
    </Grid>
    <Border Grid.Row="2" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Margin="-20,0">
      <DockPanel Margin="20,0" VerticalAlignment="Center">
        <TextBlock x:Name="StatusText" Text="{local:Tr 'Sẵn sàng · Token được mã hóa bằng tài khoản Windows khi lưu.'}" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
